var ordinal int

onStart => {
    hide
    for i := 0; i < 3; i++ { clone i }
}
onCloned data => {
    ordinal = data.(int)
    digits := []string{"0","1","2","3","4","5"}
    forever => {
        i := zombieSlots[ordinal]
        hide
        if !frontEnd() && i > 0 && entity[i] == 2 && zombieType[i] != 3 {
            total := 1; if zombieType[i] == 0 { total = 5 }; if zombieType[i] == 2 { total = 3 }
            value := (hp[i]*total+maxHP[i]-1)/maxHP[i]
            setCostume "hp-"+digits[zombieType[i]]+"-"+digits[value]
            setXpos px[i]
            setYpos py[i]+26
            if hitFlash[i] > 0 { setSize 1.12 } else { setSize 1 }
            show
        }
        wait 0.02
    }
}
