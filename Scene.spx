import "strconv"
onStart => {
    setXpos 0; setYpos 0
    forever => {
        current := level; if state == 1 { current = selectedLevel }
        if current < 1 || current > 20 { current = 1 }
        setCostume "scene-"+strconv.Itoa(current)
        show
        if frontEnd() { hide }
        wait 0.1
    }
}
