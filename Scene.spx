onStart => {
    names := []string{"scene-1","scene-2","scene-3"}
    setXpos 0; setYpos 0
    forever => {
        current := level; if state == 1 { current = selectedLevel }
        if current < 1 || current > 3 { current = 1 }
        setCostume names[current-1]
        show
        wait 0.1
    }
}
