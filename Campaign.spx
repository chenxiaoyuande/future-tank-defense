import "strconv"
var part int
onStart => {
    hide
    for i := 0; i < 5; i++ { clone i }
}
onCloned data => {
    part = data.(int)
    forever => {
        hide
        if !frontEnd() {
            if part < 2 {
                life := lives; cooldown := ultimateCooldown
                setXpos -150; setYpos 130
                if part == 1 { life = lives2; cooldown = ultimateCooldown2; setXpos 150 }
                if part == 0 || twoPlayers {
                    setCostume "p"+strconv.Itoa(part+1)+"-"+strconv.Itoa(life)+"-"+strconv.Itoa((cooldown+49)/50)+langSuffix()
                    show
                }
            }
            if part == 2 {
                setCostume "stage-"+strconv.Itoa(level)+"-"+strconv.Itoa(stageKills)+langSuffix()
                setXpos 105; setYpos -155; show
            }
            if part == 3 && bossStarted && !bossDefeated && bossSlot > 0 {
                value := (hp[bossSlot]*10+maxHP[bossSlot]-1)/maxHP[bossSlot]
                setCostume "boss-"+strconv.Itoa(bossTheme)+"-"+strconv.Itoa(value)+langSuffix()
                setXpos 0; setYpos 148; show
            }
            if part == 4 && bossStarted && !bossDefeated && bossSlot > 0 && dashWindup[bossSlot] > 0 {
                setCostume "warning-"+strconv.Itoa(bossTheme)+langSuffix(); setXpos 0; setYpos 50; show
            }
        }
        setLayer Front
        wait 0.02
    }
}
