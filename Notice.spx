import "strconv"
onStart => {
    setXpos 0
    setYpos 0
    previous := -100
    wasPaused := false
    forever => {
        if state == 5 {
            mode := 1; if checkpointCoop { mode = 2 }
            setCostume "savepanel-"+strconv.Itoa(mode)+"-"+strconv.Itoa(checkpointLevel)+langSuffix(); show
        } else if state == 4 {
            setCostume "class-lab-"+strconv.Itoa(labClass)+"-"+strconv.Itoa(routeTier(labClass))+langSuffix(); show
        } else if state == 1 {
            setCostume "stage-view-"+strconv.Itoa(selectedLevel)+langSuffix()
            show
        } else if state == 6 { setCostume "home"+langSuffix(); show
        } else if state == 7 { setCostume "class-select"+langSuffix(); show
        } else if state == 8 { setCostume "settings"+langSuffix(); show
        } else if state == 2 { setCostume "clear"+langSuffix(); show
        } else if state == 3 { setCostume "win"+langSuffix(); show
        } else if state == -1 {
            setCostume "lose"+langSuffix()
            show
        } else if paused {
            setCostume "pause"+langSuffix()
            show
        } else { hide }
        if state != previous || paused != wasPaused {
            setLayer Front
            previous = state; wasPaused = paused
        }
        wait 0.1
    }
}
