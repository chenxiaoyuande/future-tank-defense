import "math"

var (
    twoPlayers bool
    selectedLevel int
    level int
    stageKills int
    waveSpawned int
    waveTarget int
    bossSlot int
    bossStarted bool
    bossDefeated bool
    menuDown bool
    confirmDown bool
    lives2 int
    shield2 int
    shotDelay2 int
    ultimateCooldown2 int
    ultimateDown2 bool
    shieldCharges2 int
    shieldBuff2 int
    speedBuff2 int
    pepperBuff2 int
    px [192]float64
    py [192]float64
    facing [192]int
    entity [192]int
    age [192]int
    hp [192]int
    maxHP [192]int
    zombieType [192]int
    zombieSlots [3]int
    dashCooldown [192]int
    dashRemaining [192]float64
    dashWindup [192]int
    hitFlash [192]int
    growth [192]int
    velx [192]float64
    vely [192]float64
    rocket [192]bool
    incendiary [192]bool
    projectileDamage [192]int
    pickupType [192]int
    pickupTimer int
    shieldCharges int
    shieldBuff int
    speedBuff int
    pepperBuff int
    pickupNotice int
    lastPickup int
    score int
    kills int
    lives int
    ticks int
    shotDelay int
    shield int
    state int
    weaponLevel int
    upgradeFlash int
    ultimateCooldown int
    ultimateDown bool
    restartDown bool
    pauseDown bool
    paused bool
)

func vx(d int) float64 { if d == 1 { return 1 }; if d == 3 { return -1 }; return 0 }
func vy(d int) float64 { if d == 0 { return 1 }; if d == 2 { return -1 }; return 0 }
func overlaps(x float64, y float64, i int, radius float64) bool {
    return math.Abs(x-px[i]) < radius && math.Abs(y-py[i]) < radius
}
func addEntity(k int, x float64, y float64, d int) int {
    for i := 2; i < 191; i++ {
        if entity[i] == 0 {
            entity[i] = k; px[i] = x; py[i] = y; facing[i] = d; age[i] = 0
            hp[i] = 0; maxHP[i] = 0; hitFlash[i] = 0; growth[i] = 0
            dashCooldown[i] = 0; dashWindup[i] = 0; dashRemaining[i] = 0
            rocket[i] = false; incendiary[i] = false; projectileDamage[i] = 1; velx[i] = vx(d); vely[i] = vy(d)
            return i
        }
    }
    return 0
}
func blocked(x float64, y float64, self int) bool {
    if x < -214 || x > 214 || y < -132 || y > 120 { return true }
    for j := 1; j < 192; j++ {
        k := entity[j]
        if j != self && k >= 1 && k <= 5 && overlaps(x,y,j,22) { return true }
    }
    return false
}
func towardPlayer(i int) int {
    target := 1
    if entity[1] != 1 || (entity[191] == 1 && math.Hypot(px[191]-px[i],py[191]-py[i]) < math.Hypot(px[1]-px[i],py[1]-py[i])) { target = 191 }
    dx := px[target]-px[i]; dy := py[target]-py[i]
    if math.Abs(dx) > math.Abs(dy) { if dx > 0 { return 1 }; return 3 }
    if dy > 0 { return 0 }; return 2
}
func spawnZombie(i int) bool {
    for attempt := 0; attempt < 48; attempt++ {
        side := int(rand(0,4))
        x := float64(int(rand(0,19))*24-216)
        y := float64(120-int(rand(0,11))*24)
        if side == 0 { y = 120 }; if side == 1 { x = 214 }
        if side == 2 { y = -132 }; if side == 3 { x = -214 }
        dx := x-px[1]; dy := y-py[1]
        if !blocked(x,y,i) && dx*dx+dy*dy > 110*110 && (entity[191] != 1 || math.Hypot(x-px[191],y-py[191]) > 110) && (math.Abs(x) > 70 || y > -60) {
            px[i] = x; py[i] = y; entity[i] = 13; age[i] = 0
            health := 1
            if zombieType[i] == 0 { health = 5 }; if zombieType[i] == 2 { health = 3 }
            hp[i] = health; maxHP[i] = health
            dashCooldown[i] = 150; dashRemaining[i] = 0; dashWindup[i] = 0
            hitFlash[i] = 0; facing[i] = towardPlayer(i)
            return true
        }
    }
    return false
}
func fire(i int) {
    shots := 1
    if (i == 1 || i == 191) && weaponLevel == 1 { shots = 3 }
    for n := 0; n < shots; n++ {
        angle := 0.0
        if shots == 3 { angle = float64(n-1)*16*math.Pi/180 }
        dx := vx(facing[i])*math.Cos(angle)-vy(facing[i])*math.Sin(angle)
        dy := vx(facing[i])*math.Sin(angle)+vy(facing[i])*math.Cos(angle)
        kind := 7
        if i == 1 || i == 191 { kind = 6 }
        slot := addEntity(kind,px[i]+dx*19,py[i]+dy*19,facing[i])
        if slot != 0 {
            velx[slot] = dx; vely[slot] = dy; rocket[slot] = (i == 1 || i == 191) && weaponLevel == 1
            if (i == 1 && pepperBuff > 0) || (i == 191 && pepperBuff2 > 0) { projectileDamage[slot] = 2; incendiary[slot] = true }
        }
    }
}
func damageZombie(i int, damage int) {
    if entity[i] != 2 { return }
    hp[i] -= damage; hitFlash[i] = 7
    if hp[i] <= 0 {
        hp[i] = 0; entity[i] = 12; age[i] = 0; dashRemaining[i] = 0; dashWindup[i] = 0
        score += 100; kills++
        if zombieType[i] == 3 { bossDefeated = true; score += 900 } else { stageKills++ }
        if kills >= 3 && weaponLevel == 0 { weaponLevel = 1; upgradeFlash = 100 }
    }
}
func breakHedge(i int) { if entity[i] == 3 { entity[i] = 11; age[i] = 0; growth[i] = 0 } }
func growthBlocked(i int) bool {
    if entity[1] == 1 && overlaps(px[i],py[i],1,27) { return true }
    if entity[191] == 1 && overlaps(px[i],py[i],191,27) { return true }
    for j := 2; j < 192; j++ {
        if (entity[j] == 2 || entity[j] == 13) && overlaps(px[i],py[i],j,27) { return true }
    }
    return false
}
func updateHedge(i int) {
    if age[i] >= 300 {
        if growthBlocked(i) { growth[i] = 0 } else { growth[i]++ }
        if growth[i] >= 50 { entity[i] = 3; age[i] = 0; growth[i] = 0 }
    }
}
func castUltimate() bool {
    if state != 0 || paused || entity[1] != 1 || ultimateCooldown > 0 { return false }
    d := facing[1]
    slot := addEntity(9,px[1]+vx(d)*24,py[1]+vy(d)*24,d)
    if slot == 0 { return false }
    ultimateCooldown = 250; return true
}
func detonate(x float64, y float64) {
    blast(x,y,3,88)
    addEntity(10,x,y,0)
}
func blast(x float64, y float64, damage int, radius float64) {
    for i := 2; i < 192; i++ {
        dx := px[i]-x; dy := py[i]-y
        if dx*dx+dy*dy <= radius*radius {
            if entity[i] == 2 { damageZombie(i,damage) }
            if entity[i] == 3 { breakHedge(i) }
            if entity[i] == 7 { entity[i] = 0 }
        }
    }
}
func spawnPickup() bool {
    count := 0
    for i := 2; i < 192; i++ { if entity[i] == 14 { count++ } }
    if count >= 3 { return false }
    for attempt := 0; attempt < 60; attempt++ {
        x := float64(int(rand(0,17))*24-192)
        y := float64(108-int(rand(0,10))*24)
        occupied := blocked(x,y,0) || overlaps(x,y,1,50)
        for i := 2; i < 192; i++ {
            if (entity[i] == 11 || entity[i] == 13 || entity[i] == 14) && overlaps(x,y,i,28) { occupied = true }
        }
        if !occupied {
            i := addEntity(14,x,y,0)
            if i > 0 { pickupType[i] = int(rand(0,4)); return true }
            return false
        }
    }
    return false
}
func collectPickup(i int) {
    if entity[i] != 14 { return }
    kind := pickupType[i]; entity[i] = 0; lastPickup = kind; pickupNotice = 100
    if kind == 0 { shieldCharges = 3; shieldBuff = 500 }
    if kind == 1 { blast(px[1],py[1],5,100); addEntity(15,px[1],py[1],0) }
    if kind == 2 { speedBuff = 400 }
    if kind == 3 { pepperBuff = 400 }
    addEntity(8,px[1],py[1],0)
}
func updateUltimateInput() {
    if ultimateCooldown > 0 { ultimateCooldown-- }
    down := keyPressed(KeyE)
    if down && !ultimateDown { castUltimate() }
    ultimateDown = down
}
func hitPlayer() {
    if shield > 0 { return }
    if shieldBuff > 0 && shieldCharges > 0 {
        shieldCharges--; shield = 25
        if shieldCharges == 0 { shieldBuff = 0 }
        addEntity(8,px[1],py[1],0); return
    }
    addEntity(8,px[1],py[1],0); lives--
    if lives <= 0 { entity[1] = 0; if entity[191] != 1 { state = -1 }; return }
    respawnPlayer(1); facing[1] = 0; shield = 110
}
func stepZombie(i int, distance float64) bool {
    nx := px[i]+vx(facing[i])*distance; ny := py[i]+vy(facing[i])*distance
    if blocked(nx,ny,i) { return false }
    px[i] = nx; py[i] = ny; return true
}
func updateZombie(i int) {
    kind := zombieType[i]
    if kind == 3 { updateBoss(i); return }
    if hitFlash[i] > 0 { hitFlash[i]-- }
    if kind == 2 {
        dashCooldown[i]--
        if dashCooldown[i] == 12 && dashRemaining[i] <= 0 { facing[i] = towardPlayer(i); dashWindup[i] = 12 }
        if dashCooldown[i] <= 0 { dashCooldown[i] = 150; dashWindup[i] = 0; dashRemaining[i] = 72 }
    }
    if kind == 2 && dashRemaining[i] > 0 {
        for sub := 0; sub < 3 && dashRemaining[i] > 0; sub++ {
            if stepZombie(i,3) { dashRemaining[i] -= 3 } else { dashRemaining[i] = 0 }
        }
    } else if dashWindup[i] > 0 {
        dashWindup[i]--
    } else {
        if age[i]%80 == 0 { facing[i] = towardPlayer(i) }
        speed := 1.15
        if kind == 0 { speed = 0.65 }; if kind == 1 { speed = 2.25 }
        if !stepZombie(i,speed) { facing[i] = (facing[i]+1+int(rand(0,3)))%4 }
    }
    if entity[1] == 1 && overlaps(px[i],py[i],1,26) { hitPlayer() }
    if entity[191] == 1 && overlaps(px[i],py[i],191,26) { hitSecondPlayer() }
    if age[i]%(100+kind*15) == 35 && dashRemaining[i] <= 0 && dashWindup[i] == 0 { fire(i) }
}
func restart() {
    for i := 0; i < 192; i++ {
        entity[i] = 0; age[i] = 0; hp[i] = 0; maxHP[i] = 0; growth[i] = 0
        dashCooldown[i] = 0; dashRemaining[i] = 0; dashWindup[i] = 0; hitFlash[i] = 0; rocket[i] = false; incendiary[i] = false
    }
    level = selectedLevel
    if level < 1 || level > 3 { level = 1; selectedLevel = 1 }
    stageKills = 0; waveSpawned = 3; waveTarget = 3+level*3; bossSlot = 0; bossStarted = false; bossDefeated = false
    lives2 = 3; shield2 = 100; shotDelay2 = 0; ultimateCooldown2 = 0; ultimateDown2 = false
    shieldCharges2 = 0; shieldBuff2 = 0; speedBuff2 = 0; pepperBuff2 = 0
    score = 0; kills = 0; lives = 3; ticks = 0; shotDelay = 0; shield = 100
    state = 0; weaponLevel = 0; upgradeFlash = 0; paused = false; ultimateCooldown = 0; ultimateDown = false
    pickupTimer = 250; shieldCharges = 0; shieldBuff = 0; speedBuff = 0; pepperBuff = 0; pickupNotice = 0
    entity[1] = 1; px[1] = -48; py[1] = -120; facing[1] = 0
    if twoPlayers { entity[191] = 1; px[191] = 48; py[191] = -120; facing[191] = 0 }
    addEntity(5,0,-120,0)
    for col := 0; col < 19; col++ {
        for row := 2; row <= 9; row++ {
            wall := (col == 2 || col == 6 || col == 12 || col == 16) && row != 6
            if row == 5 && (col == 8 || col == 9 || col == 10) { wall = true }
            if row == 8 && (col == 8 || col == 10) { wall = true }
            if level == 2 { wall = (row == 3 || row == 7) && col > 1 && col < 17 && col%4 != 1 && col != 9 }
            if level == 3 { wall = (col == 4 || col == 14) && row != 5 && row != 8 || row == 5 && col >= 7 && col <= 11 && col != 9 }
            if wall {
                k := 3; if row == 5 && (col == 6 || col == 12) { k = 4 }
                addEntity(k,float64(col*24-216),float64(132-row*24),0)
            }
        }
    }
    addEntity(3,-24,-120,0); addEntity(3,24,-120,0); addEntity(3,-24,-96,0); addEntity(3,0,-96,0); addEntity(3,24,-96,0)
    for t := 0; t < 3; t++ {
        i := addEntity(12,0,0,0); zombieSlots[t] = i; zombieType[i] = t
        age[i] = 50; spawnZombie(i)
    }
}
func updateGame() {
    if state != 0 || paused { return }
    ticks++
    updateSecondPlayer()
    if shieldBuff > 0 { shieldBuff--; if shieldBuff == 0 { shieldCharges = 0 } }
    if speedBuff > 0 { speedBuff-- }; if pepperBuff > 0 { pepperBuff-- }; if pickupNotice > 0 { pickupNotice-- }
    pickupTimer--
    if pickupTimer <= 0 { spawnPickup(); pickupTimer = 400 }
    if shield > 0 { shield-- }; if shotDelay > 0 { shotDelay-- }; if upgradeFlash > 0 { upgradeFlash-- }
    d := -1
    if keyPressed(KeyW) || (!twoPlayers && keyPressed(KeyUp)) { d = 0 }; if keyPressed(KeyD) || (!twoPlayers && keyPressed(KeyRight)) { d = 1 }
    if keyPressed(KeyS) || (!twoPlayers && keyPressed(KeyDown)) { d = 2 }; if keyPressed(KeyA) || (!twoPlayers && keyPressed(KeyLeft)) { d = 3 }
    if d >= 0 && entity[1] == 1 {
        facing[1] = d; speed := 2.7; if speedBuff > 0 { speed = 4.185 }
        nx := px[1]+vx(d)*speed; ny := py[1]+vy(d)*speed
        if !blocked(nx,ny,1) { px[1] = nx; py[1] = ny }
    }
    updateUltimateInput()
    if keyPressed(KeySpace) && entity[1] == 1 && shotDelay == 0 { fire(1); shotDelay = 14 }
    for i := 2; i < 192; i++ {
        if state != 0 { return }
        k := entity[i]; if k != 0 { age[i]++ }
        if k == 2 { updateZombie(i) }
        if k == 11 { updateHedge(i) }
        if k == 12 && age[i] >= 50 && !bossStarted && waveSpawned < waveTarget { if spawnZombie(i) { waveSpawned++ } }
        if k == 13 && age[i] >= 20 && !blocked(px[i],py[i],i) { entity[i] = 2; age[i] = 0 }
        if k == 14 {
            if entity[1] == 1 && overlaps(px[i],py[i],1,23) { collectPickup(i) } else if entity[191] == 1 && overlaps(px[i],py[i],191,23) { collectSecondPickup(i) } else if age[i] >= 900 { entity[i] = 0 }
        }
        if k == 6 || k == 7 || k == 9 {
            flying := true; steps := 3; if k == 9 { steps = 4 }
            for sub := 0; sub < steps && flying; sub++ {
                px[i] += velx[i]*2.5; py[i] += vely[i]*2.5
                edge := px[i] < -227 || px[i] > 227 || py[i] < -145 || py[i] > 134
                if edge {
                    x := px[i]; y := py[i]; entity[i] = 0; flying = false
                    if k == 9 { detonate(x,y) }
                }
                for j := 1; j < 192 && flying; j++ {
                    target := entity[j]; valid := target > 0 && target < 6
                    if (k == 6 || k == 9) && target == 1 { valid = false }
                    if k == 7 && target == 2 { valid = false }
                    if (k == 6 || k == 9) && target == 5 { valid = false }
                    radius := 14.0; if k == 9 { radius = 22 }; if target == 2 && zombieType[j] == 3 { radius = 26 }
                    if valid && overlaps(px[i],py[i],j,radius) {
                        flying = false; x := px[i]; y := py[i]; entity[i] = 0
                        if k == 9 { detonate(x,y) } else {
                            if target == 3 { breakHedge(j); addEntity(8,px[j],py[j],0) }
                            if target == 2 { damageZombie(j,projectileDamage[i]); addEntity(8,px[j],py[j],0) }
                            if target == 1 { if j == 191 { hitSecondPlayer() } else { hitPlayer() } }
                            if target == 5 { entity[j] = 0; state = -1; addEntity(8,px[j],py[j],0) }
                        }
                    }
                }
            }
        }
        if k == 8 && age[i] > 12 { entity[i] = 0 }
        if k == 10 && age[i] > 30 { entity[i] = 0 }
        if k == 15 && age[i] > 30 { entity[i] = 0 }
    }
    if state == 0 && stageKills >= waveTarget && !bossStarted { startBoss() }
    if state == 0 && bossDefeated { state = 2; if level == 3 { state = 3 } }
}

// Player two owns independent cooldowns, lives and pickup effects.
func hitSecondPlayer() {
    if shield2 > 0 || entity[191] != 1 { return }
    if shieldBuff2 > 0 && shieldCharges2 > 0 {
        shieldCharges2--; shield2 = 25
        if shieldCharges2 == 0 { shieldBuff2 = 0 }; return
    }
    addEntity(8,px[191],py[191],0); lives2--
    if lives2 <= 0 { entity[191] = 0; if entity[1] != 1 { state = -1 }; return }
    respawnPlayer(191); facing[191] = 0; shield2 = 110
}
func respawnPlayer(i int) {
    preferred := -48.0; if i == 191 { preferred = 48 }
    best := 1000000.0
    for row := 0; row < 11; row++ {
        for col := 0; col < 17; col++ {
            x := float64(col*24-192); y := float64(row*24-120)
            distance := (x-preferred)*(x-preferred)+(y+120)*(y+120)
            if distance < best && !blocked(x,y,i) { best = distance; px[i] = x; py[i] = y }
        }
    }
}
func collectSecondPickup(i int) {
    kind := pickupType[i]; entity[i] = 0
    if kind == 0 { shieldCharges2 = 3; shieldBuff2 = 500 }
    if kind == 1 { blast(px[191],py[191],5,100); addEntity(15,px[191],py[191],0) }
    if kind == 2 { speedBuff2 = 400 }; if kind == 3 { pepperBuff2 = 400 }
    addEntity(8,px[191],py[191],0)
}
func updateSecondPlayer() {
    if !twoPlayers || entity[191] != 1 { return }
    if shield2 > 0 { shield2-- }; if shotDelay2 > 0 { shotDelay2-- }
    if ultimateCooldown2 > 0 { ultimateCooldown2-- }
    if shieldBuff2 > 0 { shieldBuff2--; if shieldBuff2 == 0 { shieldCharges2 = 0 } }
    if speedBuff2 > 0 { speedBuff2-- }; if pepperBuff2 > 0 { pepperBuff2-- }
    d := -1
    if keyPressed(KeyUp) { d = 0 }; if keyPressed(KeyRight) { d = 1 }
    if keyPressed(KeyDown) { d = 2 }; if keyPressed(KeyLeft) { d = 3 }
    if d >= 0 {
        facing[191] = d; speed := 2.7; if speedBuff2 > 0 { speed = 4.185 }
        x := px[191]+vx(d)*speed; y := py[191]+vy(d)*speed
        if !blocked(x,y,191) { px[191] = x; py[191] = y }
    }
    if keyPressed(KeyJ) && shotDelay2 == 0 { fire(191); shotDelay2 = 14 }
    down := keyPressed(KeyK)
    if down && !ultimateDown2 && ultimateCooldown2 == 0 {
        d := facing[191]
        if addEntity(9,px[191]+vx(d)*24,py[191]+vy(d)*24,d) != 0 { ultimateCooldown2 = 250 }
    }
    ultimateDown2 = down
}
func startBoss() {
    bossStarted = true
    for i := 2; i < 191; i++ { if entity[i] == 12 { entity[i] = 0 } }
    // Clear a landing zone so the large boss never appears inside a hedge.
    for i := 2; i < 191; i++ { if (entity[i] == 3 || entity[i] == 4 || entity[i] == 11) && math.Abs(px[i]) < 55 && py[i] > 50 { entity[i] = 0 } }
    bossSlot = addEntity(2,0,100,2)
    if bossSlot == 0 { bossStarted = false; return }
    zombieType[bossSlot] = 3; hp[bossSlot] = 12+level*6; if twoPlayers { hp[bossSlot] += 10 }
    maxHP[bossSlot] = hp[bossSlot]; zombieSlots[0] = bossSlot
}
func updateBoss(i int) {
    if hitFlash[i] > 0 { hitFlash[i]-- }
    cycle := age[i]%150
    if cycle == 1 { facing[i] = towardPlayer(i) }
    if cycle < 100 {
        speed := 0.6; if hp[i]*2 <= maxHP[i] { speed = 1.1 }
        if !stepZombie(i,speed) { facing[i] = (facing[i]+1)%4 }
    }
    // A visible charge from tick 100, then a four-direction barrage.
    if cycle >= 100 && cycle < 125 { dashWindup[i] = 125-cycle } else { dashWindup[i] = 0 }
    if cycle == 125 || (hp[i]*2 <= maxHP[i] && cycle == 145) {
        old := facing[i]
        for d := 0; d < 4; d++ { facing[i] = d; fire(i) }; facing[i] = old
    }
    if entity[1] == 1 && overlaps(px[i],py[i],1,35) { hitPlayer() }
    if entity[191] == 1 && overlaps(px[i],py[i],191,35) { hitSecondPlayer() }
}
func nextLevel() {
    if state != 2 { return }
    savedScore := score; savedKills := kills
    selectedLevel = level+1; restart(); score = savedScore; kills = savedKills
    if kills >= 3 { weaponLevel = 1 }
}
func updateControls() {
    m := keyPressed(KeyM)
    if m && !menuDown { state = 1; paused = false }; menuDown = m
    enter := keyPressed(KeyEnter)
    if state == 1 {
        if keyPressed(Key1) { twoPlayers = false }; if keyPressed(Key2) { twoPlayers = true }
        if keyPressed(KeyF) { selectedLevel = 1 }; if keyPressed(KeyG) { selectedLevel = 2 }; if keyPressed(KeyH) { selectedLevel = 3 }
        if enter && !confirmDown { restart() }
    } else if state == 2 && enter && !confirmDown { nextLevel() }
    confirmDown = enter
    r := keyPressed(KeyR); if r && !restartDown && state != 1 { restart() }; restartDown = r
    p := keyPressed(KeyP); if p && !pauseDown && state == 0 { paused = !paused }; pauseDown = p
}
onStart => {
    selectedLevel = 1; restart(); state = 1
    forever => {
        updateControls()
        updateGame()
        wait 0.02
    }
}
